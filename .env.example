# REA Music — Environment Configuration Template
# Duplicate this file as .env.local to configure your local runtime.
# CAUTION: Never commit actual keys, tokens, or credentials to version control.

# Vercel OpenID Connect Token (Internal serverless auth token, optional for local dev)
VERCEL_OIDC_TOKEN=your_vercel_oidc_token_here

# Local Development Server Port (Defaults to 4500 if unset)
PORT=4500
