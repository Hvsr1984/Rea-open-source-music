{
  "name": "rea-music",
  "version": "2.5.0",
  "description": "High-fidelity Apple Music style lossless Indian music streaming player with JioSaavn API integration and synchronized karaoke lyrics.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node -e \"import('node:fs').then(fs => { if (fs.existsSync('build.js')) import('./build.js'); else console.log('[REA] Pre-built assets ready'); })\"",
    "build:local": "node build.js",
    "build:web": "node scripts/build-web.js",
    "verify": "node scripts/verify-project.js",
    "test": "node tests/smoke-test.js",
    "test:personalization": "node tests/test-personalization-engine.mjs"
  },
  "keywords": [
    "music-player",
    "apple-music",
    "lossless-audio",
    "jiosaavn",
    "lyrics-sync",
    "web-audio-api",
    "glassmorphism",
    "vercel"
  ],
  "author": "Hvsr1984",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hvsr1984/Rea-open-source-music.git"
  },
  "bugs": {
    "url": "https://github.com/Hvsr1984/Rea-open-source-music/issues"
  },
  "homepage": "https://github.com/Hvsr1984/Rea-open-source-music#readme"
}
